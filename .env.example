# Generate .env.local and local RSA keys with tools/setup_local.py.
# Settings read .env first, then .env.local; process environment wins.
APP_DEBUG=false
POSTGRES_PASSWORD=local-user-service-password
POSTGRES_PORT=55432
DATABASE_URL=postgresql+asyncpg://user_service:local-user-service-password@localhost:55432/user_service

AUTH_PRIVATE_KEY_PATH=.local/keys/auth-private.pem
AUTH_PUBLIC_KEY_PATH=.local/keys/auth-public.pem
GATEWAY_PRIVATE_KEY_PATH=.local/keys/gateway-private.pem
GATEWAY_PUBLIC_KEY_PATH=.local/keys/gateway-public.pem
CSRF_SECRET=replace-this-with-at-least-32-random-characters
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:8000"]
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
# Local HTTP only. Use true with HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
GATEWAY_USER_SERVICE_URL=http://localhost:8001
GATEWAY_DOCUMENT_SERVICE_URL=http://localhost:8002
GATEWAY_AI_SERVICE_URL=http://localhost:8003
