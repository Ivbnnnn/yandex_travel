# Локальный запуск: скопируйте в .env и укажите адреса запущенных сервисов.
POSTGRES_PASSWORD=local-postgres-only
POSTGRES_PORT=55432
IDENTITY_DB_PASSWORD=local-identity-only
IDENTITY_JWT_SECRET=local-development-only-change-this-secret-please
IDENTITY_DATABASE_URL=postgresql+asyncpg://identity_service:local-identity-only@localhost:55432/travel_identity
IDENTITY_CATALOG_URL=http://localhost:8002

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=travel-gateway

GATEWAY_IDENTITY_URL=http://localhost:8001
GATEWAY_CATALOG_URL=http://localhost:8002
GATEWAY_SEARCH_URL=http://localhost:8003
GATEWAY_BOOKING_URL=http://localhost:8004
GATEWAY_PAYMENT_URL=http://localhost:8005
GATEWAY_NOTIFICATION_URL=http://localhost:8006
GATEWAY_UPSTREAM_TIMEOUT_SECONDS=10
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_MAX_REQUEST_BYTES=1048576
